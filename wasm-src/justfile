set shell := ["bash", "-cu"]

fmt:
    cargo fmt --all

clippy:
    cargo clippy --workspace --target wasm32-unknown-unknown --release -- -D warnings

build: fmt clippy
    cargo build --workspace --target wasm32-unknown-unknown --release

copy: build
    cp target/wasm32-unknown-unknown/release/area17_rules_wasm.wasm ../LuaRules/wasm/area17-rules.wasm
    cp target/wasm32-unknown-unknown/release/area17_ui_wasm.wasm ../LuaUI/wasm/area17-ui.wasm

# Host tests of the crate the rules and UI share.
test:
    cargo test -p area17-shared --target "$(rustc -vV | sed -n 's/^host: //p')"

verify:
    cd ../../../.. && flock /tmp/springcabal-verify.lock ./verification/verify area17 static

verify-headless:
    cd ../../../.. && flock /tmp/springcabal-verify.lock ./verification/verify area17 headless
